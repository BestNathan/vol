#!/usr/bin/env bash
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ── Staged files ─────────────────────────────────────────────────────────
STAGED_RUST=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM)

# ── Nothing to check ─────────────────────────────────────────────────────
if [ -z "$STAGED_ALL" ]; then
  exit 0
fi

HAS_ERROR=0

# ── Rust checks ──────────────────────────────────────────────────────────
if [ -n "$STAGED_RUST" ]; then
  echo -e "${YELLOW}→ cargo fmt --all -- --check${NC}"
  if ! cargo fmt --all -- --check 2>/dev/null; then
    echo -e "${RED}✗ cargo fmt failed — run 'cargo fmt --all' to fix${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ cargo fmt${NC}"
  fi

  echo -e "${YELLOW}→ cargo clippy --workspace${NC}"
  if ! cargo clippy --workspace 2>&1; then
    echo -e "${RED}✗ cargo clippy failed — fix the warnings above${NC}"
    HAS_ERROR=1
  else
    echo -e "${GREEN}✓ cargo clippy${NC}"
  fi
fi


# ── Coverage gate ──────────────────────────────────────────────────
if [ "${SKIP_COVERAGE:-0}" = "1" ]; then
  echo -e "${YELLOW}ℹ coverage skipped (SKIP_COVERAGE=1)${NC}"
else
  # Extract changed crate names from staged Rust files.
  # Cargo.toml change → check all crates (no args = full workspace).
  if echo "$STAGED_ALL" | grep -q '^Cargo.toml$'; then
    CHANGED_CRATES=""
    echo -e "${YELLOW}→ Cargo.toml staged — checking coverage for all crates${NC}"
  else
    CHANGED_CRATES=$(echo "$STAGED_RUST" \
      | sed -n 's|^crates/\([^/]*\)/.*|\1|p' \
      | sort -u \
      | tr '\n' ' ' \
      || true)
  fi

  if [ -n "$CHANGED_CRATES" ] || echo "$STAGED_ALL" | grep -q '^Cargo.toml$'; then
    echo -e "${YELLOW}→ coverage check for changed crates${NC}"
    if ./scripts/check-coverage.sh $CHANGED_CRATES; then
      echo -e "${GREEN}✓ coverage${NC}"
    else
      echo -e "${RED}✗ coverage failed — add tests and retry, or SKIP_COVERAGE=1 to bypass${NC}"
      HAS_ERROR=1
    fi
  fi
fi
# ── Result ───────────────────────────────────────────────────────────────
if [ $HAS_ERROR -eq 1 ]; then
  echo -e "\n${RED}Commit blocked — fix the issues above and try again${NC}"
  exit 1
fi

echo -e "\n${GREEN}All checks passed ✓${NC}"
exit 0
