#!/usr/bin/env bash
# Pre-commit quality gate: fast checks only (fmt, lint, typecheck).
# Slow checks (unit tests) run at pre-push.
#
# All checks run via just recipes.  First failure stops the chain.
# No bypass: all checks must pass before committing.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# ── Detect what changed ───────────────────────────────────────────────
CHANGES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$CHANGES" ]; then
  exit 0
fi

eval "$(echo "$CHANGES" | "$SCRIPT_DIR/scripts/detect-changes.sh")"

if [ "$NO_CHANGES" = "true" ]; then
  exit 0
fi

# `just` is only needed when a gate actually runs — docs-only commits
# must not require it.
if ! command -v just >/dev/null 2>&1; then
  echo "pre-commit requires 'just' (https://just.systems) — install it first."
  exit 1
fi

HAS_ERROR=0

# ── Plaintext-secret check (only when deploy/ or k8s/ changed) ───────
if [ "$DEPLOY_CHANGED" = "true" ]; then
  "$SCRIPT_DIR/scripts/check-no-plaintext-secrets.sh" || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi
fi

# ── Rust checks ───────────────────────────────────────────────────────
if [ "$RUST_CHANGED" = "true" ]; then
  just fmt-check || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi

  just clippy || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi

  just no-clippy-allow || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi
fi

# ── Frontend checks ───────────────────────────────────────────────────
if [ "$FRONTEND_CHANGED" = "true" ]; then
  just fe-fmt-check || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi

  just fe-lint || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi

  just fe-type || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi
fi

echo ""
echo -e "\033[0;32mAll pre-commit checks passed ✓\033[0m"
exit 0
