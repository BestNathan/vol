#!/usr/bin/env bash
# Pre-push quality gate: unit tests for changed crates.
# Pre-commit already ran fmt/lint/type checks, so we assume those passed.
#
# Test tiers:
#   unit        → pre-push (this hook, changed crates only)
#   integration → CI (quality.yml)
#   coverage    → CI (quality.yml coverage job)
#   e2e         → manual e2e.yml workflow (workflow_dispatch, secrets-gated)
#
# All checks run via just recipes.  No bypass: all checks must pass before pushing.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# ── Detect what changed in the push range ─────────────────────────────
REMOTE=${1:-origin}
REMOTE_URL=${2:-}

# Get the range of commits being pushed, or fall back to main..HEAD
PUSH_RANGE=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -n "$remote_sha" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    PUSH_RANGE="$remote_sha..$local_sha"
  else
    PUSH_RANGE="origin/main..HEAD"
  fi
  break
done

if [ -z "$PUSH_RANGE" ]; then
  PUSH_RANGE="origin/main..HEAD"
fi

CHANGES=$(git diff --name-only "$PUSH_RANGE" 2>/dev/null || git diff --name-only origin/main...HEAD)
if [ -z "$CHANGES" ]; then
  echo "No changes to push — skipping pre-push checks."
  exit 0
fi

eval "$(echo "$CHANGES" | "$SCRIPT_DIR/scripts/detect-changes.sh")"

if [ "$NO_CHANGES" = "true" ]; then
  echo "No Rust or frontend changes in push range — skipping."
  exit 0
fi

HAS_ERROR=0

# ── Rust clippy-allow check (fast, runs first) ─────────────────────────
if [ "$RUST_CHANGED" = "true" ]; then
  if ! command -v just >/dev/null 2>&1; then
    echo "pre-push requires 'just' (https://just.systems) — install it first."
    exit 1
  fi
  just no-clippy-allow || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi
fi

# ── Rust unit tests (changed crates only) ──────────────────────────────
if [ "$RUST_CHANGED" = "true" ]; then
  # Extract changed crate PACKAGE names. Workspace members nest (e.g.
  # crates/vol-llm-tools-builtin/bash-tool/ is its own package named
  # vol-llm-tools-builtin-bash), so resolve the deepest path prefix with a
  # Cargo.toml and read the real package name from it (directory names are
  # not package names).
  CHANGED_CRATES=""
  for path in $(echo "$CHANGES" | grep '^crates/'); do
    dir=${path%/*}
    while [ -n "$dir" ] && [ "$dir" != "crates" ]; do
      if [ -f "$dir/Cargo.toml" ]; then
        crate=$(sed -n 's/^name = "\(.*\)"/\1/p' "$dir/Cargo.toml" | head -1)
        [ -z "$crate" ] && crate=${dir##*/}
        case " $CHANGED_CRATES " in
          *" $crate "*) ;;
          *) CHANGED_CRATES="$CHANGED_CRATES $crate" ;;
        esac
        break
      fi
      dir=${dir%/*}
    done
  done
  CHANGED_CRATES=${CHANGED_CRATES# }

  if [ -n "$CHANGED_CRATES" ]; then
    echo "→ Changed crates: $CHANGED_CRATES"
    just test-unit-crates $CHANGED_CRATES || HAS_ERROR=1
  else
    echo "→ No crates/ paths changed (workspace-level change) — running full workspace unit tests."
    just test-unit || HAS_ERROR=1
  fi

  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi
fi

# ── Frontend unit tests ────────────────────────────────────────────────
if [ "$FRONTEND_CHANGED" = "true" ]; then
  if ! command -v just >/dev/null 2>&1; then
    echo "pre-push requires 'just' (https://just.systems) — install it first."
    exit 1
  fi
  just fe-test || HAS_ERROR=1
  if [ $HAS_ERROR -eq 1 ]; then exit 1; fi
fi

echo ""
echo -e "\033[0;32mAll pre-push checks passed ✓\033[0m"
exit 0
